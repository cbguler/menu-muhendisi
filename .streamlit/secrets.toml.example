# .streamlit/secrets.toml.example
#
# Bu dosyayı .streamlit/secrets.toml olarak kopyala ve gerçek değerleri
# Supabase projenden al (Settings > API). secrets.toml ASLA commitlenmez
# (.gitignore'da zaten hariç tutuldu) -- bu .example dosyası sadece hangi
# alanların gerektiğini göstermek için commitlenir.

SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_ANON_KEY = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
